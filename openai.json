{
  "openapi": "3.1.0",
  "info": {
    "title": "Loja Itau API",
    "description": "API de loja e investimentos para buscar produtos, abrir detalhes, comprar itens e consultar OpenBanking com saldo e carteiras de investimentos. Sempre que o usuario perguntar sobre carteira, saldo investido, bancos conectados, OpenBanking, BancoA ou BancoB, use a operacao getUserInvestments.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://SUA-URL-DA-LOJA.com",
      "description": "Servidor da loja"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "description": "Lista os produtos disponiveis na loja.",
        "operationId": "listProducts",
        "responses": {
          "200": {
            "description": "Produtos retornados com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "name": { "type": "string" },
                      "description": { "type": "string" },
                      "price": { "type": "number" },
                      "imageUrl": { "type": "string" },
                      "stock": { "type": "integer" }
                    },
                    "required": [
                      "id",
                      "name",
                      "description",
                      "price",
                      "imageUrl",
                      "stock"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products/search": {
      "get": {
        "description": "Busca produto por linguagem natural, ex: 'quero um iphone, tem?'.",
        "operationId": "searchProduct",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Pergunta do usuario ou nome do produto"
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado da busca",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": { "type": "string" },
                    "found": { "type": "boolean" },
                    "answer": { "type": "string" },
                    "product": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "description": { "type": "string" },
                            "price": { "type": "number" },
                            "imageUrl": { "type": "string" },
                            "stock": { "type": "integer" }
                          }
                        },
                        { "type": "null" }
                      ]
                    }
                  },
                  "required": ["query", "found", "answer", "product"]
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "description": "Retorna detalhes de um produto pelo id.",
        "operationId": "getProductById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhes do produto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "price": { "type": "number" },
                    "imageUrl": { "type": "string" },
                    "stock": { "type": "integer" }
                  },
                  "required": [
                    "id",
                    "name",
                    "description",
                    "price",
                    "imageUrl",
                    "stock"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/cover-competitor-price": {
      "post": {
        "description": "Verifica se conseguimos cobrir (bater) o preco de um concorrente para um produto. Use esta funcao quando o usuario disser frases como: 'voces cobrem esse preco?', 'conseguem bater o preco do concorrente?', 'vi mais barato em outra loja', 'voces dao desconto para cobrir?'. Retorna o preco coberto com desconto de R$50 em relacao ao valor do concorrente.",
        "operationId": "coverCompetitorPrice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "competitorPrice": {
                    "type": "number",
                    "description": "Preco encontrado no concorrente. Obrigatorio. Deve ser maior que zero."
                  },
                  "productId": {
                    "type": "string",
                    "description": "ID do produto na nossa loja (opcional, use se souber)."
                  },
                  "productName": {
                    "type": "string",
                    "description": "Nome ou descricao do produto mencionado pelo usuario (opcional)."
                  },
                  "competitorStore": {
                    "type": "string",
                    "description": "Nome da loja concorrente onde o usuario viu o preco (opcional)."
                  },
                  "currency": {
                    "type": "string",
                    "description": "Moeda do preco informado, ex: BRL, USD. Padrao: BRL.",
                    "default": "BRL"
                  }
                },
                "required": ["competitorPrice"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado da cobertura de preco",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "canCover": { "type": "boolean" },
                    "competitorPrice": { "type": "number" },
                    "coveredPrice": { "type": "number" },
                    "discountApplied": { "type": "number" },
                    "currency": { "type": "string" },
                    "message": { "type": "string" }
                  },
                  "required": [
                    "canCover",
                    "competitorPrice",
                    "coveredPrice",
                    "discountApplied",
                    "currency",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/cover-flight-trip": {
      "post": {
        "description": "Verifica se uma viagem de aviao pode ser coberta com pontos/milhas do usuario. Use quando o usuario perguntar quantas milhas tem, se a passagem sai de graca, ou se consegue viajar usando pontos. Considere que 3000 pontos equivalem a R$ 1500, ou seja, 1 ponto vale R$ 0,50. Se o saldo cobrir o valor da passagem, a viagem pode sair de graca.",
        "operationId": "coverFlightTrip",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string",
                    "description": "ID do usuario que tem os pontos/milhas. Obrigatorio."
                  },
                  "flightPrice": {
                    "type": "number",
                    "description": "Preco da passagem a ser coberta. Obrigatorio."
                  },
                  "origin": {
                    "type": "string",
                    "description": "Cidade ou aeroporto de origem da viagem."
                  },
                  "destination": {
                    "type": "string",
                    "description": "Cidade ou aeroporto de destino da viagem."
                  },
                  "airline": {
                    "type": "string",
                    "description": "Companhia aerea, se o usuario mencionar."
                  },
                  "tripName": {
                    "type": "string",
                    "description": "Nome livre para descrever a viagem."
                  }
                },
                "required": ["userId", "flightPrice"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado da cobertura da viagem",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "canCover": { "type": "boolean" },
                    "user": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "email": { "type": "string" },
                            "points": { "type": "number" }
                          }
                        },
                        { "type": "null" }
                      ]
                    },
                    "flightPrice": { "type": "number" },
                    "pointsBalance": { "type": "number" },
                    "pointsValueInReais": { "type": "number" },
                    "pointsRequiredForFreeTrip": { "type": "number" },
                    "pointsUsed": { "type": "number" },
                    "remainingPoints": { "type": "number" },
                    "totalPaid": { "type": "number" },
                    "origin": { "type": "string" },
                    "destination": { "type": "string" },
                    "airline": { "type": "string" },
                    "tripName": { "type": "string" },
                    "message": { "type": "string" }
                  },
                  "required": [
                    "canCover",
                    "user",
                    "flightPrice",
                    "pointsBalance",
                    "pointsValueInReais",
                    "pointsRequiredForFreeTrip",
                    "pointsUsed",
                    "remainingPoints",
                    "totalPaid",
                    "origin",
                    "destination",
                    "airline",
                    "tripName",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/purchase": {
      "post": {
        "description": "Finaliza compra de um produto para um usuario.",
        "operationId": "purchaseProduct",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "string" },
                  "productId": { "type": "string" },
                  "usePoints": { "type": "boolean" }
                },
                "required": ["userId", "productId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compra realizada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "productId": { "type": "string" },
                    "totalPaid": { "type": "number" },
                    "discountPercent": { "type": "number" }
                  },
                  "required": ["productId", "totalPaid", "discountPercent"]
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}/investments": {
      "get": {
        "description": "Retorna a carteira consolidada de investimentos do usuario, incluindo o banco principal e os bancos conectados via OpenBanking. Use esta operacao quando o usuario perguntar: 'meus investimentos', 'minha carteira', 'saldo nos bancos conectados', 'dados do BancoA/BancoB', 'open banking'.",
        "operationId": "getUserInvestments",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID do usuario",
            "example": "user-1"
          }
        ],
        "responses": {
          "200": {
            "description": "Carteira consolidada do usuario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "found": { "type": "boolean" },
                    "openBanking": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "enabled": { "type": "boolean" },
                            "connectedBanks": {
                              "type": "array",
                              "items": { "type": "string" }
                            },
                            "permissions": {
                              "type": "array",
                              "items": { "type": "string" }
                            }
                          },
                          "required": [
                            "enabled",
                            "connectedBanks",
                            "permissions"
                          ]
                        },
                        { "type": "null" }
                      ]
                    },
                    "accounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "bank": { "type": "string" },
                          "accountType": { "type": "string" },
                          "balance": { "type": "number" },
                          "currency": { "type": "string" },
                          "investedAmount": { "type": "number" },
                          "currentInvestmentValue": { "type": "number" },
                          "investments": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": { "type": "string" },
                                "name": { "type": "string" },
                                "category": { "type": "string" },
                                "investedAmount": { "type": "number" },
                                "currentValue": { "type": "number" },
                                "profitability": { "type": "string" },
                                "annualYield": { "type": "string" },
                                "liquidity": { "type": "string" }
                              },
                              "required": [
                                "id",
                                "name",
                                "category",
                                "investedAmount",
                                "currentValue",
                                "profitability"
                              ]
                            }
                          }
                        },
                        "required": [
                          "bank",
                          "accountType",
                          "balance",
                          "currency",
                          "investments"
                        ]
                      }
                    },
                    "cashBalance": { "type": "number" },
                    "investedAmount": { "type": "number" },
                    "currentInvestmentValue": { "type": "number" },
                    "consolidatedAssets": { "type": "number" },
                    "message": { "type": "string" },
                    "user": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "email": { "type": "string" },
                            "points": { "type": "number" }
                          }
                        },
                        { "type": "null" }
                      ]
                    }
                  },
                  "required": [
                    "found",
                    "openBanking",
                    "accounts",
                    "cashBalance",
                    "investedAmount",
                    "currentInvestmentValue",
                    "consolidatedAssets",
                    "message",
                    "user"
                  ],
                  "examples": [
                    {
                      "found": true,
                      "openBanking": {
                        "enabled": true,
                        "connectedBanks": ["BancoA", "BancoB"],
                        "permissions": [
                          "saldo",
                          "investimentos",
                          "posicaoConsolidada"
                        ]
                      },
                      "accounts": [
                        {
                          "bank": "Itaú",
                          "accountType": "Conta corrente",
                          "balance": 128430.18,
                          "currency": "BRL",
                          "investedAmount": 85000,
                          "currentInvestmentValue": 88723.22,
                          "investments": []
                        },
                        {
                          "bank": "BancoA",
                          "accountType": "Conta digital",
                          "balance": 45210.55,
                          "currency": "BRL",
                          "investedAmount": 42000,
                          "currentInvestmentValue": 44690.99,
                          "investments": []
                        }
                      ],
                      "cashBalance": 192400.85,
                      "investedAmount": 167000,
                      "currentInvestmentValue": 175586.13,
                      "consolidatedAssets": 367986.98,
                      "message": "Portfolio consolidado de Lucas com acesso OpenBanking.",
                      "user": {
                        "id": "user-1",
                        "name": "Lucas",
                        "email": "lucas@example.com",
                        "points": 5000
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Usuario nao encontrado"
          },
          "401": {
            "description": "Nao autorizado (quando OAuth estiver habilitado)"
          }
        }
      }
    }
  }
}
