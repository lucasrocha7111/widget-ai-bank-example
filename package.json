{
  "name": "bank-ia-api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build:store-widget": "bun build ./src/store-widget.tsx --outfile ./public/assets/store-widget.js",
    "build:product-detail-widget": "bun build ./src/product-detail-widget.tsx --outfile ./public/assets/product-detail-widget.js",
    "build:todo-widget": "bun build ./src/todo-widget.tsx --outfile ./public/assets/todo-widget.js",
    "build:all": "bun build ./src/store-widget.tsx --outfile ./public/assets/store-widget.js && bun build ./src/product-detail-widget.tsx --outfile ./public/assets/product-detail-widget.js && bun build ./src/todo-widget.tsx --outfile ./public/assets/todo-widget.js"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  }
}